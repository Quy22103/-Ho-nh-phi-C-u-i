# GEMINI_API_KEY: Khóa API Google Gemini (chỉ sử dụng phía backend, không đưa vào frontend hoặc GitHub).
# Trong AI Studio, biến này được tự động nạp từ mục Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Đường dẫn URL của ứng dụng khi triển khai.
APP_URL="http://localhost:3000"

# PORT: Cổng chạy máy chủ Express (mặc định 3000).
PORT="3000"

# DATA_FILE_PATH: Đường dẫn tới tệp dữ liệu tulieu.json (mặc định ./data/tulieu.json).
DATA_FILE_PATH="./data/tulieu.json"

# IMAGES_DIR: Thư mục lưu trữ ảnh gốc và ảnh thu nhỏ tách biệt khỏi thư mục công khai.
IMAGES_DIR="./storage/images"

# PENDING_IMAGES_DIR: Thư mục lưu ảnh chờ xác nhận từ biểu mẫu đóng góp (chỉ ADMIN/REVIEWER mới xem được).
PENDING_IMAGES_DIR="./storage/pending_images"

# USERS_FILE_PATH & AUDIT_LOG_FILE_PATH: Lưu tài khoản (đã băm BCrypt) và lịch sử thao tác bất biến.
USERS_FILE_PATH="./data/users.json"
AUDIT_LOG_FILE_PATH="./data/audit_log.json"

# SESSION_SECRET: Chuỗi bí mật ký cookie phiên đăng nhập (tự sinh ngẫu nhiên an toàn nếu để trống).
SESSION_SECRET=""
SESSION_TTL_HOURS="8"
